e,"value":"import remeta\ncfg = remeta.Configuration()\ncfg.param_type2_noise.group = 'random'\ncfg.optim_type1_linearize = True\ncfg.optim_type2_gridsearch = True\ncfg.optim_num_cores = -1  # multiprocessing: -1 = use all cores except one\nrem = remeta.ReMeta(cfg)\nrem.fit(stimuli, choices, confidence, verbosity=0)  # Takes at least a few minutes\nresult = rem.summary()","key":"ZyJAUVM98M"},{"type":"outputs","id":"LcRQV1BAJc6SSxFPBuJ6E","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Fitting of confidence criteria is enabled, but `n_ratings` was not passed. Using the default of 4 confidence ratings / 3 confidence criteria. To suppress this message, pass `n_ratings=X` to the `fit` method.\n"},"children":[],"key":"yjMpaIYFRu"}],"key":"R3jeYHVzZy"}],"key":"XWJ2yVxkY9"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"As noted by the message, by default ReMeta fits four confidence ratings (corresponding to 3 confidence criteria) − even if confidence ratings are continuous as in this case.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cUgskLffhk"}],"key":"ogxH6yOTfD"}],"key":"C3Ehsbg3jo"},{"type":"block","kind":"notebook-code","data":{"tags":[],"ExecuteTime":{"end_time":"2026-06-11T18:58:49.214120764Z","start_time":"2026-06-11T18:58:49.143116373Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# import joblib\n# joblib.dump(rem, '../data/shekhar_2021_session1.joblib')","visibility":"show","key":"FCNat4M8lI"},{"type":"outputs","id":"sGXnZBy_762gFzdPBIuAs","children":[],"visibility":"show","key":"ZhLQE5MGTN"}],"visibility":"remove","key":"oSp1SdI3qN"},{"type":"block","kind":"notebook-code","data":{"tags":[],"ExecuteTime":{"end_time":"2026-06-11T18:58:49.266149373Z","start_time":"2026-06-11T18:58:49.216067462Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# import joblib\n# rem = joblib.load('../data/shekhar_2021_session1.joblib')","visibility":"show","key":"AdCitqV7LE"},{"type":"outputs","id":"TSKLKUmU0oSUoFywU1lqM","children":[],"visibility":"show","key":"ntRvx59dwR"}],"visibility":"remove","key":"V3pwhUXpSW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We can visualize the distribution of the parameters","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EGATPDjE2S"}],"key":"fXoThl30NP"}],"key":"XF8K7wFb2D"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-11T18:58:51.148127509Z","start_time":"2026-06-11T18:58:49.267379219Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nplt.figure(figsize=(10, 6))\nfor i, param in enumerate(['type1_bias', 'type1_noise', 'type2_noise']):\n    plt.subplot(2, 3, i + 1)\n    plt.hist([p[param] for p in result.params])\n    plt.title(param)\nfor i in range(3):\n    plt.subplot(2, 3, i + 4)\n    plt.hist([p['type2_criteria'][i] for p in result.params])\n    plt.title(f'Criterion {i + 1}')\nplt.tight_layout()","key":"mtmjkVeXNP"},{"type":"outputs","id":"D3vgV8SlUY9XNye92vtXv","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x600 with 6 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"3a580ddad997f5c85a81b89361ab2561","path":"/build/3a580ddad997f5c85a81b89361ab2561.png"}}},"children":[],"key":"CGQgnfwtgq"}],"key":"ctseVTOPzz"}],"key":"T50mqCInvC"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"... and the confidence bias:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"x5HbNz1iND"}],"key":"fPNHhqMPwu"}],"key":"ljiZ3Q6ixn"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-11T18:58:51.497525431Z","start_time":"2026-06-11T18:58:51.270949513Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"plt.figure(figsize=(3, 3))\nplt.hist([p['type2_criteria_confidence_bias'] for p in result.params_extra])\nplt.title('Confidence bias');","key":"BXgs8rD30E"},{"type":"outputs","id":"BqRAYvcl_8hRI1p8CaVwY","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"203ffb59037621d22fc2464afed075c7","path":"/build/203ffb59037621d22fc2464afed075c7.png"}}},"children":[],"key":"dH6rMRBHsV"}],"key":"qCsDNCsflp"}],"key":"Xt64h27neB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"It is strongly recommended to validate the fitted parameters against some descriptive measures.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PMbZPB8hrm"}],"key":"gIQ67Dlm3e"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"First, type 1 noise should correlate (negatively) with accuracy:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MKNM2GKxr6"}],"key":"Sic5tiKcEp"}],"key":"g0bMM3vjOK"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-11T18:58:51.734139352Z","start_time":"2026-06-11T18:58:51.534414362Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"data_accuracy = [np.mean((np.array(stim) > 0) == np.array(dec, bool)) for stim, dec in zip(stimuli, choices)]\nmodel_type1_noise = [p['type1_noise'] for p in result.params]\nplt.figure(figsize=(3, 3))\nplt.scatter(data_accuracy, model_type1_noise)\nplt.xlabel('Accuracy (data)')\nplt.ylabel('Type 1 noise (model)')\nfrom scipy.stats import spearmanr\nr, p = spearmanr(data_accuracy, model_type1_noise)\nplt.text(0.97, 0.9, f'r={r:.3f} (p={p:.3f})', transform=plt.gca().transAxes, ha='right')","key":"W0iqKNOYno"},{"type":"outputs","id":"BzZ_OTecToe50ID9-jj95","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"f34cef15a829f924fdb7055da29b652a","path":"/build/f34cef15a829f924fdb7055da29b652a.png"}}},"children":[],"key":"pExrggA31k"}],"key":"Rqh1PalBch"}],"key":"PZVhqapGxG"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Second, type 2 noise should bear some relationship with how much average confidence differs between correct and incorrect choices (higher metacognitive noise -> less pronounced difference):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gZJiVfoLBp"}],"key":"x4RJVldtly"}],"key":"mIrmqYCabE"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-11T18:58:51.936440074Z","start_time":"2026-06-11T18:58:51.750413016Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"data_confidence_correct = [np.mean([c for i, c in enumerate(conf) if int(stim[i] > 0) == dec[i]]) for stim, dec, conf in zip(stimuli, choices, confidence)]\ndata_confidence_incorrect = [np.mean([c for i, c in enumerate(conf) if int(stim[i] > 0) != dec[i]]) for stim, dec, conf in zip(stimuli, choices, confidence)]\ndata_confidence_correct_m_incorrect = np.array(data_confidence_correct) - np.array(data_confidence_incorrect)\nmodel_type2_noise = [p['type2_noise'] for p in result.params]\nplt.figure(figsize=(3, 3))\nplt.scatter(data_confidence_correct_m_incorrect, model_type2_noise)\nplt.xlabel('Confidence correct – incorrect (data)')\nplt.ylabel('Type 2 noise (model)')\nr, p = spearmanr(data_confidence_correct_m_incorrect, model_type2_noise)\nplt.text(0.97, 0.9, f'r={r:.3f} (p={p:.3f})', transform=plt.gca().transAxes, ha='right')","key":"gSehMdmyJo"},{"type":"outputs","id":"21ncCIsYpGjpwlx6pdJp3","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"71f99fca9a919b344672ec9ff7ffb294","path":"/build/71f99fca9a919b344672ec9ff7ffb294.png"}}},"children":[],"key":"zLcpMV52Oy"}],"key":"lx9ntQoRxW"}],"key":"eHBTQKGwxh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Third, the confidence bias should typically correlate positively with average confidence:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZzaEdT9TP7"}],"key":"kQAlMqhvLt"}],"key":"FynPZyPJ9Y"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-11T18:58:52.155377561Z","start_time":"2026-06-11T18:58:51.951160960Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"data_average_confidence = [np.mean(conf) for conf in confidence]\nmodel_confidence_bias = [p['type2_criteria_confidence_bias'] for p in result.params_extra]\nplt.figure(figsize=(3, 3))\nplt.scatter(data_average_confidence, model_confidence_bias)\nplt.xlabel('Average confidence (data)')\nplt.ylabel('Confidence bias (model)')\nr, p = spearmanr(data_average_confidence, model_confidence_bias)\nplt.text(0.03, 0.9, f'r={r:.3f} (p={p:.3f})', transform=plt.gca().transAxes)","key":"rRvUACDGvN"},{"type":"outputs","id":"DDTEXJt1Gkxh8YmLV1K0w","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"869724e7e634c54f197398fce00b95b0","path":"/build/869724e7e634c54f197398fce00b95b0.png"}}},"children":[],"key":"B2OC6cPx6y"}],"key":"gJAYBeP1n2"}],"key":"tWXEwPqa60"}],"key":"RSHeoKRrs3"},"references":{"cite":{"order":["Shekhar2021"],"data":{"Shekhar2021":{"label":"Shekhar2021","enumerator":"1","doi":"10.1037/rev0000249","html":"Shekhar, M., & Rahnev, D. (2021). The nature of metacognitive inefficiency in perceptual decision making. <i>Psychological Review</i>, <i>128</i>(1), 45–70. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1037/rev0000249\">10.1037/rev0000249</a>","url":"https://doi.org/10.1037/rev0000249"}}}},"footer":{"navigation":{"prev":{"title":"Type 2: the metacognitive stage","url":"/type2","group":"Guide"},"next":{"title":"Stimulus evidence","url":"/stimulus-evidence","group":"Guide"}}},"domain":"http://localhost:3000"}