p(stimuli, choices)]\nmodel_type1_noise = [p['type1_noise'] for p in result.params]\nplt.figure(figsize=(3, 3))\nplt.scatter(data_accuracy, model_type1_noise)\nplt.xlabel('Accuracy (data)')\nplt.ylabel('Type 1 noise (model)')\nfrom scipy.stats import spearmanr\nr, p = spearmanr(data_accuracy, model_type1_noise)\nplt.text(0.97, 0.9, f'r={r:.3f} (p={p:.3f})', transform=plt.gca().transAxes, ha='right')","key":"ta1IAFXRsR"},{"type":"outputs","id":"tx1cpnoINmjD8f-23v8_o","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"f34cef15a829f924fdb7055da29b652a","path":"/build/f34cef15a829f924fdb7055da29b652a.png"}}},"children":[],"key":"U0HkOe3xdF"}],"key":"caz8P1StXE"}],"key":"iQE3t4NKRU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Second, type 2 noise should bear some relationship with how much average confidence differs between correct and incorrect choices (higher metacognitive noise -> less pronounced difference):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ewRTWoFWSg"}],"key":"CLiIxCFfdH"}],"key":"mzhEODwJIZ"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-09T13:40:18.673899841Z","start_time":"2026-06-09T13:40:17.875945557Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"data_confidence_correct = [np.mean([c for i, c in enumerate(conf) if int(stim[i] > 0) == dec[i]]) for stim, dec, conf in zip(stimuli, choices, confidence)]\ndata_confidence_incorrect = [np.mean([c for i, c in enumerate(conf) if int(stim[i] > 0) != dec[i]]) for stim, dec, conf in zip(stimuli, choices, confidence)]\ndata_confidence_correct_m_incorrect = np.array(data_confidence_correct) - np.array(data_confidence_incorrect)\nmodel_type2_noise = [p['type2_noise'] for p in result.params]\nplt.figure(figsize=(3, 3))\nplt.scatter(data_confidence_correct_m_incorrect, model_type2_noise)\nplt.xlabel('Confidence correct – incorrect (data)')\nplt.ylabel('Type 2 noise (model)')\nr, p = spearmanr(data_confidence_correct_m_incorrect, model_type2_noise)\nplt.text(0.97, 0.9, f'r={r:.3f} (p={p:.3f})', transform=plt.gca().transAxes, ha='right')","key":"YNHtyAOwAC"},{"type":"outputs","id":"vLCeC1nlBg_PhzUUvT_BB","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"71f99fca9a919b344672ec9ff7ffb294","path":"/build/71f99fca9a919b344672ec9ff7ffb294.png"}}},"children":[],"key":"HVW7douNA7"}],"key":"lL12a8abYc"}],"key":"TrGRQG5Mko"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Third, the confidence bias should typically correlate positively with average confidence:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wjRtix6fpB"}],"key":"EkqkZbl4F8"}],"key":"nOuXppvyrH"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-09T13:34:38.580840405Z","start_time":"2026-06-09T13:34:38.326881218Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"data_average_confidence = [np.mean(conf) for conf in confidence]\nmodel_confidence_bias = [p['type2_criteria_confidence_bias'] for p in result.params_extra]\nplt.figure(figsize=(3, 3))\nplt.scatter(data_average_confidence, model_confidence_bias)\nplt.xlabel('Average confidence (data)')\nplt.ylabel('Confidence bias (model)')\nr, p = spearmanr(data_average_confidence, model_confidence_bias)\nplt.text(0.03, 0.9, f'r={r:.3f} (p={p:.3f})', transform=plt.gca().transAxes)","key":"H5uJiAMCLt"},{"type":"outputs","id":"TG3R2YKQwSjHgN0snyMTl","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"869724e7e634c54f197398fce00b95b0","path":"/build/869724e7e634c54f197398fce00b95b0.png"}}},"children":[],"key":"Ns3rLxrNaM"}],"key":"vx8YVNS3LS"}],"key":"QUseUDLTU0"}],"key":"EbtwypHUKM"},"references":{"cite":{"order":["Shekhar2021"],"data":{"Shekhar2021":{"label":"Shekhar2021","enumerator":"1","doi":"10.1037/rev0000249","html":"Shekhar, M., & Rahnev, D. (2021). The nature of metacognitive inefficiency in perceptual decision making. <i>Psychological Review</i>, <i>128</i>(1), 45–70. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1037/rev0000249\">10.1037/rev0000249</a>","url":"https://doi.org/10.1037/rev0000249"}}}},"footer":{"navigation":{"prev":{"title":"Type 2: the metacognitive stage","url":"/type2","group":"Guide"},"next":{"title":"Stimulus evidence","url":"/stimulus-evidence","group":"Guide"}}},"domain":"http://localhost:3000"}