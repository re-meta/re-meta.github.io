e,"value":"import remeta\ncfg = remeta.Configuration()\ncfg.param_type2_noise.group = 'random'\ncfg.optim_type1_linearize = True\ncfg.optim_type2_gridsearch = True\ncfg.optim_num_cores = -1  # multiprocessing: -1 = use all cores except one\nrem = remeta.ReMeta(cfg)\nrem.fit(stimuli, choices, confidence, verbosity=0)  # Takes at least a few minutes\nresult = rem.summary()","key":"DX0xvOHZFa"},{"type":"outputs","id":"U1ZG-xPQ5fv6ot_rK_tr1","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Fitting of confidence criteria is enabled, but `n_ratings` was not passed. Using the default of 4 confidence ratings / 3 confidence criteria. To suppress this message, pass `n_ratings=X` to the `fit` method.\n"},"children":[],"key":"AtvKKTEHPr"}],"key":"TLGj6rXGQs"}],"key":"g4y9nDcJ6y"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"As noted by the message, by default ReMeta fits four confidence ratings (corresponding to 3 confidence criteria) − even if confidence ratings are continuous as in this case.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sq4q7ngvNJ"}],"key":"GmFCLPcGl2"}],"key":"E8hXd7nwbQ"},{"type":"block","kind":"notebook-code","data":{"tags":[],"ExecuteTime":{"end_time":"2026-06-11T18:58:49.214120764Z","start_time":"2026-06-11T18:58:49.143116373Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# import joblib\n# joblib.dump(rem, '../data/shekhar_2021_session1.joblib')","visibility":"show","key":"BtSVwV7cCv"},{"type":"outputs","id":"qVK6oqQdyMbpgDWmeoDPT","children":[],"visibility":"show","key":"ijPgkxAzlB"}],"visibility":"remove","key":"mMPLscux8X"},{"type":"block","kind":"notebook-code","data":{"tags":[],"ExecuteTime":{"end_time":"2026-06-11T18:58:49.266149373Z","start_time":"2026-06-11T18:58:49.216067462Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# import joblib\n# rem = joblib.load('../data/shekhar_2021_session1.joblib')","visibility":"show","key":"ikJcEoLkMa"},{"type":"outputs","id":"BixDf4lE7r36YkySd7vbf","children":[],"visibility":"show","key":"kyQgGLOlZ4"}],"visibility":"remove","key":"r06miUG62g"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We can visualize the distribution of the parameters","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ysCG34kee2"}],"key":"CzPeGUAjYq"}],"key":"qALiGBOdQK"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-11T18:58:51.148127509Z","start_time":"2026-06-11T18:58:49.267379219Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nplt.figure(figsize=(10, 6))\nfor i, param in enumerate(['type1_bias', 'type1_noise', 'type2_noise']):\n    plt.subplot(2, 3, i + 1)\n    plt.hist([p[param] for p in result.params])\n    plt.title(param)\nfor i in range(3):\n    plt.subplot(2, 3, i + 4)\n    plt.hist([p['type2_criteria'][i] for p in result.params])\n    plt.title(f'Criterion {i + 1}')\nplt.tight_layout()","key":"afCXHAOJh8"},{"type":"outputs","id":"GxkVOCfBG2dU4x9pfkZMh","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x600 with 6 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"3a580ddad997f5c85a81b89361ab2561","path":"/build/3a580ddad997f5c85a81b89361ab2561.png"}}},"children":[],"key":"oeem8c0WU3"}],"key":"eCuDeoOT6U"}],"key":"XzfT4nGkQO"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"... and the confidence bias:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"le44pjpBOv"}],"key":"koSCgJt0ZA"}],"key":"T1BaR3kgBM"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-11T18:58:51.497525431Z","start_time":"2026-06-11T18:58:51.270949513Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"plt.figure(figsize=(3, 3))\nplt.hist([p['type2_criteria_confidence_bias'] for p in result.params_extra])\nplt.title('Confidence bias');","key":"gcWj9ZP6IP"},{"type":"outputs","id":"y0X2LH2XVnq46IuA2u_GI","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"203ffb59037621d22fc2464afed075c7","path":"/build/203ffb59037621d22fc2464afed075c7.png"}}},"children":[],"key":"CXmQLibVCS"}],"key":"dlT4XL3GK2"}],"key":"Eq7WtVEhVB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"It is strongly recommended to validate the fitted parameters against some descriptive measures.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bTep20GH2J"}],"key":"myYa5KrfdT"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"First, type 1 noise should correlate (negatively) with accuracy:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xw9tOavpmD"}],"key":"FaTuqdXsds"}],"key":"aypZYXPX9P"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-11T18:58:51.734139352Z","start_time":"2026-06-11T18:58:51.534414362Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"data_accuracy = [np.mean((np.array(stim) > 0) == np.array(dec, bool)) for stim, dec in zip(stimuli, choices)]\nmodel_type1_noise = [p['type1_noise'] for p in result.params]\nplt.figure(figsize=(3, 3))\nplt.scatter(data_accuracy, model_type1_noise)\nplt.xlabel('Accuracy (data)')\nplt.ylabel('Type 1 noise (model)')\nfrom scipy.stats import spearmanr\nr, p = spearmanr(data_accuracy, model_type1_noise)\nplt.text(0.97, 0.9, f'r={r:.3f} (p={p:.3f})', transform=plt.gca().transAxes, ha='right')","key":"mzgRImyIbJ"},{"type":"outputs","id":"p4mK5fI40-z3q6tvzwy0V","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"f34cef15a829f924fdb7055da29b652a","path":"/build/f34cef15a829f924fdb7055da29b652a.png"}}},"children":[],"key":"t8RqWaznaA"}],"key":"MIIpMmQg4T"}],"key":"Qjho4PgmAW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Second, type 2 noise should bear some relationship with how much average confidence differs between correct and incorrect choices (higher metacognitive noise -> less pronounced difference):","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WnNg0a2yOS"}],"key":"RXpTgU69tb"}],"key":"bz5z7yzv4u"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-11T18:58:51.936440074Z","start_time":"2026-06-11T18:58:51.750413016Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"data_confidence_correct = [np.mean([c for i, c in enumerate(conf) if int(stim[i] > 0) == dec[i]]) for stim, dec, conf in zip(stimuli, choices, confidence)]\ndata_confidence_incorrect = [np.mean([c for i, c in enumerate(conf) if int(stim[i] > 0) != dec[i]]) for stim, dec, conf in zip(stimuli, choices, confidence)]\ndata_confidence_correct_m_incorrect = np.array(data_confidence_correct) - np.array(data_confidence_incorrect)\nmodel_type2_noise = [p['type2_noise'] for p in result.params]\nplt.figure(figsize=(3, 3))\nplt.scatter(data_confidence_correct_m_incorrect, model_type2_noise)\nplt.xlabel('Confidence correct – incorrect (data)')\nplt.ylabel('Type 2 noise (model)')\nr, p = spearmanr(data_confidence_correct_m_incorrect, model_type2_noise)\nplt.text(0.97, 0.9, f'r={r:.3f} (p={p:.3f})', transform=plt.gca().transAxes, ha='right')","key":"ODDuTGxQqh"},{"type":"outputs","id":"cwYhdt7QPMpGjVhuyjAIQ","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"71f99fca9a919b344672ec9ff7ffb294","path":"/build/71f99fca9a919b344672ec9ff7ffb294.png"}}},"children":[],"key":"uN2JWYemRl"}],"key":"arIyabFps0"}],"key":"cmOhBSZB1J"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Third, the confidence bias should typically correlate positively with average confidence:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gI2uLhFnZv"}],"key":"DXviqU0hp0"}],"key":"oProqJGN2u"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-11T18:58:52.155377561Z","start_time":"2026-06-11T18:58:51.951160960Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"data_average_confidence = [np.mean(conf) for conf in confidence]\nmodel_confidence_bias = [p['type2_criteria_confidence_bias'] for p in result.params_extra]\nplt.figure(figsize=(3, 3))\nplt.scatter(data_average_confidence, model_confidence_bias)\nplt.xlabel('Average confidence (data)')\nplt.ylabel('Confidence bias (model)')\nr, p = spearmanr(data_average_confidence, model_confidence_bias)\nplt.text(0.03, 0.9, f'r={r:.3f} (p={p:.3f})', transform=plt.gca().transAxes)","key":"yIOA9CuE91"},{"type":"outputs","id":"x9oNVxd9Py7wiE650ZhKg","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 300x300 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"869724e7e634c54f197398fce00b95b0","path":"/build/869724e7e634c54f197398fce00b95b0.png"}}},"children":[],"key":"nSlWMGzNjI"}],"key":"aPej6f04nc"}],"key":"WfTtiLIdlD"}],"key":"IP8CiHy7Tg"},"references":{"cite":{"order":["Shekhar2021"],"data":{"Shekhar2021":{"label":"Shekhar2021","enumerator":"1","doi":"10.1037/rev0000249","html":"Shekhar, M., & Rahnev, D. (2021). The nature of metacognitive inefficiency in perceptual decision making. <i>Psychological Review</i>, <i>128</i>(1), 45–70. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1037/rev0000249\">10.1037/rev0000249</a>","url":"https://doi.org/10.1037/rev0000249"}}}},"footer":{"navigation":{"prev":{"title":"Type 2: the metacognitive stage","url":"/type2","group":"Guide"},"next":{"title":"Stimulus evidence","url":"/stimulus-evidence","group":"Guide"}}},"domain":"http://localhost:3000"}